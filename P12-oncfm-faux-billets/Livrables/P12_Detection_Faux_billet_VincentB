    "from sklearn.metrics import silhouette_score\n",
    "\n",
    "inerties = []\n",
    "scores_silhouette = []\n",
    "valeurs_k_cluster = range(2, 7)\n",
    "\n",
    "for k in valeurs_k_cluster:\n",
    "    modele_test = KMeans(n_clusters=k, random_state=RANDOM_STATE, n_init=10)\n",
    "    labels_test = modele_test.fit_predict(X_train_scaled)\n",
    "    inerties.append(modele_test.inertia_)\n",
    "    scores_silhouette.append(silhouette_score(X_train_scaled, labels_test))\n",
